# Crinoid Social — Environment Variables Template

# 1. Supabase (Database & Authentication)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. Google / YouTube Data API v3 OAuth 2.0
VITE_YOUTUBE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_YOUTUBE_CLIENT_SECRET=your-google-client-secret

# 3. Meta (Facebook & Instagram Graph API)
VITE_META_APP_ID=your-meta-app-id
VITE_META_APP_SECRET=your-meta-app-secret

# 4. Email Services (Invitation & Notification Dispatch)
# Option A: Direct Gmail SMTP (Recommended for unrestricted sending)
GMAIL_USER=crinoidsocial@gmail.com
GMAIL_APP_PASSWORD=your-16-char-gmail-app-password

# Option B: Resend Email Service
VITE_RESEND_API_KEY=re_your_resend_api_key
